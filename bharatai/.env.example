# BharatAI — Government Website Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and configure your values

# -------------------------------------------------------------
# GROQ API CONFIGURATION (MANDATORY)
# -------------------------------------------------------------
# Provide your actual Groq API key below.
# Never commit your real API key to git.
GROQ_API_KEY=your_groq_api_key_here

# Groq Chat Completions API endpoint
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq Model ID (e.g., llama-3.3-70b-versatile, llama3-70b-8192, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq request timeout in seconds
GROQ_TIMEOUT_SECONDS=45

# Maximum retry attempts for transient API failures (429, 500, 503)
GROQ_MAX_RETRIES=3

# Temperature for answer generation (0.0 to 1.0)
GROQ_TEMPERATURE=0.1

# Maximum output tokens
GROQ_MAX_TOKENS=2048

# -------------------------------------------------------------
# EMBEDDING & VECTOR DATABASE CONFIGURATION
# -------------------------------------------------------------
# Sentence-Transformers model name for local embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Persistent ChromaDB directory path
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Document chunking parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Default Top-K retrieved chunks
RETRIEVAL_TOP_K=5

# Minimum similarity threshold (0.0 to 1.0)
RELEVANCE_THRESHOLD=0.35

# -------------------------------------------------------------
# CRAWLER CONFIGURATION
# -------------------------------------------------------------
# Maximum pages to crawl per website
CRAWLER_MAX_PAGES_PER_SITE=25

# Maximum crawl depth
CRAWLER_MAX_DEPTH=2

# Delay between requests in seconds (to be respectful to servers)
CRAWLER_REQUEST_DELAY=1.0

# Request timeout in seconds
CRAWLER_TIMEOUT_SECONDS=15

# User Agent string for the crawler
CRAWLER_USER_AGENT=BharatAI-Government-Information-Bot/1.0 (+https://github.com/gov-bharatai)

# -------------------------------------------------------------
# AGENT & PIPELINE CONFIGURATION
# -------------------------------------------------------------
# Maximum retries in JEV Layer 3 Quality Gate
QUALITY_GATE_MAX_RETRIES=2

# Default response language
DEFAULT_RESPONSE_LANGUAGE=en

# SQLite database file path
DATABASE_PATH=./data/bharatai.db
